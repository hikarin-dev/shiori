{
 "name": "desktop-s30",
 "commit": "146199d",
 "about": "S30, before S31: manifests naming no publication, stamps of their generation and writer alone",
 "schema": [
  {
   "type": "table",
   "name": "meta",
   "sql": "CREATE TABLE meta (\n  gid TEXT PRIMARY KEY,\n  source_id TEXT,\n  is_stub INTEGER NOT NULL DEFAULT 0,\n  record TEXT NOT NULL\n)"
  },
  {
   "type": "index",
   "name": "meta_source",
   "sql": "CREATE INDEX meta_source ON meta (source_id, gid) WHERE source_id IS NOT NULL"
  },
  {
   "type": "table",
   "name": "meta_tags",
   "sql": "CREATE TABLE meta_tags (\n  tag TEXT NOT NULL,\n  gid TEXT NOT NULL,\n  PRIMARY KEY (tag, gid)\n) WITHOUT ROWID"
  },
  {
   "type": "index",
   "name": "meta_tags_gid",
   "sql": "CREATE INDEX meta_tags_gid ON meta_tags (gid)"
  },
  {
   "type": "table",
   "name": "stats",
   "sql": "CREATE TABLE stats (\n  gid TEXT PRIMARY KEY,\n  latest_at REAL,\n  added_at REAL,\n  size REAL,\n  count REAL,\n  upload_date REAL,\n  parent_key TEXT,\n  child INTEGER NOT NULL DEFAULT 0,\n  record TEXT NOT NULL\n)"
  },
  {
   "type": "index",
   "name": "stats_latest",
   "sql": "CREATE INDEX stats_latest ON stats (latest_at, gid) WHERE latest_at IS NOT NULL"
  },
  {
   "type": "index",
   "name": "stats_added",
   "sql": "CREATE INDEX stats_added ON stats (added_at, gid) WHERE added_at IS NOT NULL"
  },
  {
   "type": "index",
   "name": "stats_size",
   "sql": "CREATE INDEX stats_size ON stats (size, gid) WHERE size IS NOT NULL"
  },
  {
   "type": "index",
   "name": "stats_count",
   "sql": "CREATE INDEX stats_count ON stats (count, gid) WHERE count IS NOT NULL"
  },
  {
   "type": "index",
   "name": "stats_upload",
   "sql": "CREATE INDEX stats_upload ON stats (upload_date, gid) WHERE upload_date IS NOT NULL"
  },
  {
   "type": "index",
   "name": "stats_parent",
   "sql": "CREATE INDEX stats_parent ON stats (parent_key) WHERE parent_key IS NOT NULL"
  },
  {
   "type": "table",
   "name": "pages",
   "sql": "CREATE TABLE pages (\n  gid TEXT NOT NULL,\n  n INTEGER NOT NULL CHECK (n >= 1),\n  key TEXT NOT NULL UNIQUE,\n  w INTEGER,\n  h INTEGER,\n  orig TEXT NOT NULL,\n  record TEXT NOT NULL,\n  PRIMARY KEY (gid, n)\n)"
  },
  {
   "type": "table",
   "name": "covers",
   "sql": "CREATE TABLE covers (gid TEXT PRIMARY KEY, record TEXT NOT NULL)"
  },
  {
   "type": "table",
   "name": "icons",
   "sql": "CREATE TABLE icons (source TEXT PRIMARY KEY, record TEXT NOT NULL)"
  },
  {
   "type": "table",
   "name": "changes",
   "sql": "CREATE TABLE changes (rev INTEGER PRIMARY KEY, gid TEXT NOT NULL, at REAL NOT NULL)"
  },
  {
   "type": "table",
   "name": "kv",
   "sql": "CREATE TABLE kv (key TEXT PRIMARY KEY, value TEXT NOT NULL)"
  },
  {
   "type": "table",
   "name": "stamps",
   "sql": "CREATE TABLE stamps (gid TEXT PRIMARY KEY, stamp TEXT NOT NULL)"
  },
  {
   "type": "table",
   "name": "personal",
   "sql": "CREATE TABLE personal (gid TEXT PRIMARY KEY, record TEXT NOT NULL)"
  },
  {
   "type": "table",
   "name": "files",
   "sql": "CREATE TABLE files (\n  gid TEXT PRIMARY KEY,\n  path TEXT NOT NULL UNIQUE,\n  format TEXT NOT NULL CHECK (format IN ('cbz', 'zip', 'folder')),\n  state TEXT NOT NULL CHECK (state IN ('packed', 'missing')),\n  packed_at REAL,\n  pending INTEGER NOT NULL DEFAULT 0,\n  unpack INTEGER NOT NULL DEFAULT 0,\n  used_at REAL,\n  tail REAL\n, source TEXT, zip_size INTEGER, zip_mtime REAL, moving TEXT, converting INTEGER NOT NULL DEFAULT 0)"
  },
  {
   "type": "table",
   "name": "staged_own",
   "sql": "CREATE TABLE staged_own (\n  gid TEXT NOT NULL,\n  rel TEXT NOT NULL,\n  file TEXT NOT NULL,\n  size INTEGER NOT NULL,\n  PRIMARY KEY (gid, rel)\n) WITHOUT ROWID"
  },
  {
   "type": "table",
   "name": "retiring",
   "sql": "CREATE TABLE retiring (\n  dir TEXT NOT NULL,\n  name TEXT NOT NULL,\n  size INTEGER,\n  mtime REAL,\n  gid TEXT,\n  PRIMARY KEY (dir, name)\n)"
  },
  {
   "type": "table",
   "name": "deleting",
   "sql": "CREATE TABLE deleting (\n  dir TEXT PRIMARY KEY,\n  gid TEXT NOT NULL,\n  files TEXT\n, unfound INTEGER NOT NULL DEFAULT 0, misses INTEGER NOT NULL DEFAULT 0, stamp TEXT, epoch INTEGER) WITHOUT ROWID"
  },
  {
   "type": "index",
   "name": "files_used",
   "sql": "CREATE INDEX files_used ON files (used_at, gid) WHERE format = 'folder'"
  },
  {
   "type": "table",
   "name": "roots",
   "sql": "CREATE TABLE roots (\n  id TEXT PRIMARY KEY,\n  path TEXT NOT NULL,\n  state TEXT NOT NULL CHECK (state IN ('shown', 'hidden', 'removing')),\n  first INTEGER NOT NULL DEFAULT 0,\n  added_at REAL NOT NULL,\n  epoch INTEGER,\n  removal TEXT\n)"
  },
  {
   "type": "table",
   "name": "places",
   "sql": "CREATE TABLE places (gid TEXT PRIMARY KEY, root TEXT NOT NULL) WITHOUT ROWID"
  },
  {
   "type": "index",
   "name": "places_root",
   "sql": "CREATE INDEX places_root ON places (root)"
  },
  {
   "type": "table",
   "name": "removed_notes",
   "sql": "CREATE TABLE removed_notes (gid TEXT PRIMARY KEY, root TEXT NOT NULL, overlay TEXT NOT NULL, source TEXT NOT NULL) WITHOUT ROWID"
  },
  {
   "type": "table",
   "name": "attention",
   "sql": "CREATE TABLE attention (root TEXT NOT NULL, reason TEXT NOT NULL, path TEXT NOT NULL, gid TEXT, event INTEGER NOT NULL DEFAULT 0,\n  at REAL NOT NULL, PRIMARY KEY (root, reason, path)) WITHOUT ROWID"
  },
  {
   "type": "view",
   "name": "unmounted",
   "sql": "CREATE VIEW unmounted AS\n  SELECT gid, root FROM places WHERE root NOT IN (SELECT id FROM roots WHERE state = 'shown')"
  }
 ],
