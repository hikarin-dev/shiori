    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tw-animate-css": "^1.4.0"
  }
