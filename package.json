{
  "name": "shiori",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && node build/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --import ./app/tests/lock-net.mjs app/tests/*.test.mjs",
    "test:browser": "npm run build && node --test app/tests/browser/*.browser.mjs",
    "test:desktop": "npm run build && node --test --test-force-exit --import ./app/tests/lock-net.mjs --import ./desktop/tests/contract-setup.mjs app/tests/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
